DISCORD_TOKEN=your_bot_token
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_service_role_key

# Optional: only for hosts that sleep idle VMs (e.g. Fly.io Sprites). Your public URL from `sprite info`.
# KEEPALIVE_URL=https://yourname-xxxx.sprites.app
# PORT=8080

# Optional: typing this word in chat opens the panel (needs Message Content Intent enabled in the portal)
# TEXT_TRIGGER=att
